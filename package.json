{
  "name": "kandidate",
  "private": true,
  "version": "0.1.0",
  "description": "KandiDate — suivi de candidatures, veille d'offres et analyse de match (Material 3 Expressive avec k3ui)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "vapid": "web-push generate-vapid-keys --json",
    "cron:local": "tsx scripts/run-cron.ts",
    "postinstall": "node scripts/check-submodules.mjs"
  },
  "dependencies": {
    "@fontsource/google-sans": "^5.3.2",
    "@material/material-color-utilities": "^0.4.0",
    "@neondatabase/serverless": "^1.0.2",
    "chart.js": "^4.6.1",
    "lit": "^3.2.1",
    "material-shapes-ts": "^0.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@tailwindcss/vite": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/web-push": "^3.6.4",
    "sass": "^1.85.1",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  }
}
