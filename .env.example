# ─── Base de données ────────────────────────────────────────────────
# Neon → projet « KandiDate » → Connection string (pooled). Absent = PGlite local (.data/pglite)
DATABASE_URL=

# ─── Accès ──────────────────────────────────────────────────────────
# Mot de passe de l'app (fortement recommandé en prod). Absent = accès libre (dev).
APP_PASSWORD=
# Secret de signature du cookie de session (openssl rand -base64 32)
SESSION_SECRET=
# URL publique (liens des emails). Sur Vercel, déduit automatiquement.
APP_URL=
APP_TIMEZONE=Europe/Paris

# ─── Veille automatique ─────────────────────────────────────────────
# Vercel Cron envoie « Authorization: Bearer $CRON_SECRET » à /api/cron/run
CRON_SECRET=

# ─── Sources d'offres ───────────────────────────────────────────────
# France Travail — francetravail.io → Mon espace → Créer une application → API « Offres d'emploi v2 »
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Adzuna — developer.adzuna.com (gratuit)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble — jooble.org/api/about (gratuit, quota limité par clé)
JOOBLE_API_KEY=
# JOOBLE_ENDPOINT=https://fr.jooble.org/api/
# La bonne alternance — api.apprentissage.beta.gouv.fr (jeton gratuit)
LBA_API_TOKEN=
# LBA_API_URL=https://api.apprentissage.beta.gouv.fr/api/job/v1/search
# Remotive (sans clé) : mettre 1 pour désactiver
REMOTIVE_DISABLED=

# ─── Notifications ──────────────────────────────────────────────────
# Web Push : npm run vapid → copier publicKey / privateKey
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@example.com
# Email (récap + réception des alertes) — resend.com
RESEND_API_KEY=
EMAIL_FROM=KandiDate <alertes@ton-domaine.fr>
# Webhook Resend « email.received » (Signing secret whsec_…)
RESEND_WEBHOOK_SECRET=
# Adresse de réception affichée dans l'app (ex. jobs@ton-domaine.fr ou xxx@xxx.resend.app)
INBOUND_ADDRESS=
# Webhook générique /api/inbound/email?token=… (Postmark, Cloudflare Email, Make…)
INBOUND_TOKEN=
